<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CameraView">
        <attr name="backend" format="enum">
            <enum name="auto" value="0"/>
            <enum name="camera2" value="1"/>
            <enum name="cameraX" value="2"/>
            <enum name="legacy" value="3"/>
        </attr>
        <attr name="quality" format="enum">
            <enum name="max" value="0"/>
            <enum name="high" value="1"/>
            <enum name="medium" value="2"/>
            <enum name="low" value="3"/>
        </attr>
        <attr name="maxVideoDuration" format="integer" />
        <attr name="maxVideoSize" format="integer" />
        <attr name="flash" format="enum">
            <enum name="auto" value="0"/>
            <enum name="on" value="1"/>
            <enum name="off" value="2"/>
        </attr>
        <attr name="confirmImages" format="boolean" />
        <attr name="confirmVideos" format="boolean" />
        <attr name="pinchToZoomEnabled" format="boolean" />
        <attr name="matchPreviewAspectRatio" format="boolean" />
        <attr name="lensFacing" format="enum">
            <enum name="back" value="0"/>
            <enum name="front" value="1"/>
        </attr>
        <attr name="dynamicRange" format="enum">
            <enum name="sdr" value="0"/>
            <enum name="hdr" value="1"/>
        </attr>
        <attr name="extension" format="enum">
            <enum name="none" value="0"/>
            <enum name="bokeh" value="1"/>
            <enum name="hdr" value="2"/>
            <enum name="night" value="3"/>
            <enum name="faceRetouch" value="4"/>
            <enum name="auto" value="5"/>
        </attr>
        <attr name="stabilizationEnabled" format="boolean" />
        <attr name="exposureCompensation" format="integer" />
        <attr name="torchEnabled" format="boolean" />
        <attr name="lowLightBoostEnabled" format="boolean" />
        <attr name="shutterSoundEnabled" format="boolean" />
        <attr name="shutterSound" format="reference" />
        <attr name="focusReticleEnabled" format="boolean" />
        <attr name="focusReticleColor" format="color" />
        <attr name="focusReticleLockedColor" format="color" />
    </declare-styleable>
    <declare-styleable name="VideoView">
        <attr name="filePath" format="string" />
    </declare-styleable>
</resources>