<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      Declared so the tests can be granted it. The library's own manifest asks for nothing - what
      a camera app needs is the app's decision - but a test that checks a recording carries where
      it was taken has to be able to hold the permission that supplies it.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      So ArDeviceTest can move the emulator's virtual scene camera, through the emulator's gRPC
      endpoint on the host. AR only starts tracking a camera that moves.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- What an app that enters AR declares, so ArDeviceTest can. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
        <activity
            android:name="com.xlythe.view.camera.test.CameraTestActivity"
            android:exported="false"
            android:screenOrientation="fullSensor" />
    </application>
</manifest>
