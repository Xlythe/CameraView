<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ViewerFragment">

    <!-- One of the three is shown at a time, whichever suits the picture. -->
    <com.xlythe.view.camera.viewer.LargeImageView
        android:id="@+id/viewer_picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.xlythe.view.camera.viewer.PanoramaView
        android:id="@+id/viewer_panorama"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.xlythe.view.camera.viewer.PhotosphereView
        android:id="@+id/viewer_photosphere"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/viewer_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/viewer_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:text="@string/viewer_empty"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewer_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/viewer_open"
            android:textColor="#FFFFFF"
            app:cornerRadius="20dp" />

        <RadioGroup
            android:id="@+id/viewer_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/viewer_mode_picture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FFFFFF"
                android:text="@string/viewer_mode_picture"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/viewer_mode_panorama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FFFFFF"
                android:text="@string/viewer_mode_panorama"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/viewer_mode_photosphere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#FFFFFF"
                android:text="@string/viewer_mode_photosphere"
                android:textColor="#FFFFFF" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/viewer_gyroscope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFF"
            android:text="@string/viewer_gyroscope"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
