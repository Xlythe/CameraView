<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ViewerFragment">

    <!-- Works out what the file is and shows it the way it suits. -->
    <com.xlythe.view.camera.viewer.MediaView
        android:id="@+id/viewer_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/viewer_media_description" />

    <TextView
        android:id="@+id/viewer_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#80000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/viewer_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/viewer_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:text="@string/viewer_empty"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewer_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/viewer_open"
            android:textColor="#FFFFFF"
            app:cornerRadius="20dp" />

        <!-- Scrolls rather than wraps where the screen is too narrow for every choice. -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioGroup
                    android:id="@+id/viewer_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkedButton="@id/viewer_type_detect"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/viewer_type_detect"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_detect" />

                    <RadioButton
                        android:id="@+id/viewer_type_picture"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_picture" />

                    <RadioButton
                        android:id="@+id/viewer_type_panorama"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_panorama" />

                    <RadioButton
                        android:id="@+id/viewer_type_photosphere"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_photosphere" />

                    <RadioButton
                        android:id="@+id/viewer_type_video"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_video" />

                    <RadioButton
                        android:id="@+id/viewer_type_motion"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_motion" />

                    <RadioButton
                        android:id="@+id/viewer_type_spherical"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_spherical" />

                    <RadioButton
                        android:id="@+id/viewer_type_audio"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_audio" />

                    <RadioButton
                        android:id="@+id/viewer_type_animation"
                        style="@style/ViewerChoice"
                        android:text="@string/viewer_mode_animation" />

                </RadioGroup>

                <CheckBox
                    android:id="@+id/viewer_gyroscope"
                    style="@style/ViewerChoice"
                    android:text="@string/viewer_gyroscope"
                    android:visibility="gone" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

</FrameLayout>
