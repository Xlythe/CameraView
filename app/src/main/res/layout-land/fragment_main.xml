<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:camera="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@id/layout_permissions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212">

        <com.google.android.material.button.MaterialButton
            android:id="@id/request_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="@string/btn_request_permissions"
            android:textColor="#FFFFFF"
            app:cornerRadius="24dp"
            app:elevation="4dp" />

    </FrameLayout>

    <LinearLayout
        android:id="@id/layout_camera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.xlythe.view.camera.CameraView
                android:id="@id/camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                camera:quality="high" />

            <!-- Exposure compensation, shown by MainFragment where the camera can compensate -->
            <!-- Photo modes, filled in by MainFragment with the ones the camera has -->
            <LinearLayout
                android:id="@+id/photo_modes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/exposure_control"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/exposure_value"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/exposure_slider"
                    android:layout_width="200dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/exposure_compensation_description" />

            </LinearLayout>

            <!-- Zoom presets, filled in by MainFragment once the camera opens -->
            <LinearLayout
                android:id="@+id/zoom_presets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal" />

        </FrameLayout>

        <!-- Side Control Bar -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:background="#40000000"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@id/confirm"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:text="@string/btn_confirm"
                android:textColor="#FFFFFF"
                app:backgroundTint="#388E3C"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@id/cancel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:text="@string/btn_cancel"
                android:textColor="#FFFFFF"
                app:backgroundTint="#D32F2F"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@id/capture"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:text="@string/btn_capture"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1976D2"
                app:cornerRadius="24dp"
                app:elevation="4dp" />

            <CheckBox
                android:id="@id/toggle"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:buttonTint="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>